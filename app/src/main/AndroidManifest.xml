<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Câmera é opcional: o app funciona em aparelhos/emuladores sem ela -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Android 11+: necessário para o app enxergar a câmera ao chamar ACTION_IMAGE_CAPTURE -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Avaliacao1">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Avaliacao1">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DetalheActivity"
            android:exported="false" />

        <!-- Pessoa 2: cadastro e edição de perfil (mesma Activity, dois modos) -->
        <activity
            android:name=".CadastroActivity"
            android:exported="false" />

        <!-- Pessoa 2: URI segura para a câmera gravar a foto -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
